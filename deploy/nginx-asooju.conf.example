# Example nginx for asooju.com when the SPA is static files + Node API on 8787.
# Critical: proxy_pass MUST NOT end with / — keep the full /api/... path.
#
# After deploy:
#   cd /path/to/app && npm ci && npm run build
#   # .env on server: PLATFORM_AI_PROVIDER=deepseek + PLATFORM_DEEPSEEK_API_KEY + …
#   npm run start:api   # or: pm2 start "npm run start:api" --name asooju-api
#
# Verify:
#   curl -sS https://asooju.com/api/healthz
#   # expect JSON {"ok":true,"platformProvider":"deepseek",...}
#   # NOT nginx HTML 405

server {
  listen 443 ssl http2;
  server_name asooju.com www.asooju.com;

  # … your ssl_certificate lines …

  root /var/www/asooju/dist;   # adjust to your deploy path
  index index.html;

  # Platform + Stripe + admin APIs → Node (tsx scripts/api-server.ts)
  location /api/ {
    proxy_pass http://127.0.0.1:8787;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Content-Type $http_content_type;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    client_max_body_size 4m;
  }

  # SPA assets + client routes
  location / {
    try_files $uri $uri/ /index.html;
  }
}
