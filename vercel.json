{
  "functions": {
    "api/ai/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/claude.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/admin/*.ts": {
      "maxDuration": 30
    },
    "api/stripe/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/vendor/(.*)", "destination": "/vendor/$1" },
    { "source": "/preview-sandbox.html", "destination": "/preview-sandbox.html" },
    { "source": "/((?!api/|vendor/|preview-sandbox\\.html|assets/).*)", "destination": "/index.html" }
  ]
}
