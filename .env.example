# Browser-safe only (Vite embeds VITE_* into the client bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: VITE_BUILD_VERIFY_BUNDLER=1 — verify waves with export Sandpack even when preview UI is Draft
# Optional: VITE_PREVIEW_V2=1 — default UI is Draft iframe; set 1 for Live Sandpack preview
# Admin UI requires app_metadata.role=admin (not an email allowlist)

# SERVER ONLY — set in Vercel/host env, never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=
# Admin console (/admin/login) — never use VITE_ for these
ADMIN_EMAIL=
ADMIN_PASSWORD=

PLATFORM_AI_PROVIDER=gemini
PLATFORM_GEMINI_API_KEY=
PLATFORM_DEEPSEEK_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
APP_ORIGIN=https://your-domain.example
# Optional: MAX_API_BODY_BYTES=3000000
# Optional: AI_HOURLY_LIMIT=40 AI_DAILY_LIMIT=120 AI_BURST_LIMIT=8 AI_MAX_CONCURRENT=2
